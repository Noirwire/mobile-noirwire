{
  "name": "mobile-noirwire",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "./index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios:sim": "expo run:ios",
    "ios:device": "node scripts/require-apple-team-id.js && expo run:ios --device",
    "ios:archive": "node scripts/require-apple-team-id.js && expo run:ios --configuration Release --device generic --output ./build",
    "android:debug": "expo run:android",
    "android:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "android:bundle": "expo prebuild --platform android && cd android && ./gradlew bundleRelease",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --ci --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:e2e": "playwright test",
    "doctor": "npx --yes expo-doctor",
    "android:ports": "bash scripts/forward-ports.sh"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@noirwire/shared": "https://github.com/Noirwire/shared-noirwire/releases/download/v0.5.2/noirwire-shared-0.5.2.tgz",
    "@react-native-community/netinfo": "12.0.1",
    "@scure/bip39": "1.6.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "buffer": "6.0.3",
    "ed25519-hd-key": "2.0.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.24",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
