# Copy to .env and fill in. Every EXPO_PUBLIC_ value is compiled into the app
# and readable by anyone who has it, so nothing secret belongs here. Restart
# Metro with `npm start -- --clear` after changing this file.

# The origin of the NoirWire API, which every request the app makes goes to
# (chain reads, prices, quotes, the fee relayer, private payments): an origin
# with no path. Pick ONE of:
#
#   Option A - the deployed API, over https:
#     EXPO_PUBLIC_API_URL=https://api.noirwire.com
#
#   Option B - the API running locally (sibling api-noirwire repo):
#     run `npm run dev:stack` there (port 4000), then with the Android device
#     or emulator connected run `adb reverse tcp:4000 tcp:4000` (or
#     `npm run android:ports` here) so it can reach the Mac's localhost, and use:
#     EXPO_PUBLIC_API_URL=http://localhost:4000
#     Plain http is accepted only in a development build, and only to
#     localhost, 127.0.0.1 or the Android emulator's 10.0.2.2.
#
# Left empty, the app stops at start and says this value is not set.
EXPO_PUBLIC_API_URL=

# mainnet or devnet. Must match the network the API at EXPO_PUBLIC_API_URL
# runs on: the local API's own .env says which (devnet by default).
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# --- Trading -------------------------------------------------------------
# NoirWire's fee on trades, collected through Jupiter's referral program.
# Both or neither - a fee with nowhere to go is refused. These must match
# the web app's own EXPO_PUBLIC_JUPITER_REFERRAL_ACCOUNT /
# NEXT_PUBLIC_NOIRWIRE_FEE_BPS values (app-noirwire/.env.example): one
# referral account collects the fee for both apps, and the Costs screen on
# each must state the same percentage. Jupiter accepts 50-255 bps.
EXPO_PUBLIC_JUPITER_REFERRAL_ACCOUNT=Fps2W6upBuMTgZpBsjgHbsjVVBthkaMfgaWfTXeKhrZw
EXPO_PUBLIC_NOIRWIRE_FEE_BPS=50
