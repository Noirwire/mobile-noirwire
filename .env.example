# Copy to .env and fill in. Every EXPO_PUBLIC_ value is compiled into the app
# and readable by anyone who has it, so nothing secret belongs here. Restart
# Metro with `npm start -- --clear` after changing this file.

# The origin the app calls for RPC, prices, Jupiter quotes and private
# payments: an https origin with no path. Pick ONE of:
#
#   Option A - a deployed relay:
#     EXPO_PUBLIC_RELAY_URL=https://app.noirwire.com
#
#   Option B - the web app running locally (sibling app-noirwire repo):
#     run `npm run dev` there (port 3000), then with the Android device or
#     emulator connected run `adb reverse tcp:3000 tcp:3000` so it can reach
#     the Mac's localhost, and use:
#     EXPO_PUBLIC_RELAY_URL=http://localhost:3000
#
# The placeholder below is neither: replace it before running the app.
EXPO_PUBLIC_RELAY_URL=https://relay.example.com

# mainnet or devnet. Must match whichever relay EXPO_PUBLIC_RELAY_URL points
# at - the local web app's own .env says which network it runs on.
EXPO_PUBLIC_SOLANA_NETWORK=devnet
